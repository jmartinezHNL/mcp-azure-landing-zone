# Plantilla de variables de entorno para "mcp-azure-landing-zone".
#
# IMPORTANTE: el servidor NO lee este fichero automáticamente (no usa python-dotenv).
# Para que las variables lleguen al proceso, expórtalas antes de arrancar:
#
#   set -a; source .env; set +a
#   .venv/bin/python server.py
#
# ...o decláralas en el bloque "env" de la configuración de tu cliente MCP.
#
# Las variables de entorno TIENEN PRIORIDAD sobre config.yaml.

# --- Configuración del servidor -------------------------------------------
# Ruta alternativa al fichero de configuración (por defecto: ./config.yaml)
# MCP_ALZ_CONFIG=/ruta/a/config.prod.yaml

# Subscripción por defecto (sustituye a azure.default_subscription_id)
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Directorio de Terraform (sustituye a terraform.working_dir)
# TERRAFORM_WORKING_DIR=/ruta/absoluta/a/tu/terraform

# --- Autenticación por service principal (solo entornos desatendidos) ------
# Obtenidos con:
#   az ad sp create-for-rbac --name "mcp-azure-landing-zone" \
#     --role Reader --scopes /subscriptions/<SUBSCRIPTION_ID>
#
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000     # campo "tenant"
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000     # campo "appId"
# AZURE_CLIENT_SECRET=                                     # campo "password" (SECRETO)

# En una máquina de desarrollo NO hace falta nada de lo anterior: basta con
# 'az login'. DefaultAzureCredential reutiliza la sesión del Azure CLI.

# --- PATH para binarios externos -------------------------------------------
# Necesario si el cliente MCP arranca el proceso con un PATH mínimo y no
# encuentra 'terraform'.
# PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
